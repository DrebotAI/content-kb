# Copy to .env and fill in. Never commit .env.

# --- required ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
DEEPGRAM_API_KEY=              # speech-to-text

# --- single-owner mode (used only when tenants.json is absent) ---
ALLOWED_USER_ID=               # numeric Telegram id; send /id to the bot to learn yours
NOTION_TOKEN=                  # Notion internal integration token
NOTION_DATABASE_ID=            # database id or full Notion URL
# TENANT_NAME=owner
# CONTEXT_FILE=context.md

# --- multi-owner mode ---
# tenants.json references extra tokens as "env:NAME"; define them here, e.g.
# COLLABORATOR_NOTION_TOKEN=
# TENANTS_FILE=                # override path to tenants.json

# --- Instagram (optional; needed for stories and logged-in-only posts) ---
# IG_COOKIES_FILE=cookies.txt
# IG_USERNAME=
# IG_PASSWORD=
# IG_USER_AGENT=
# IG_PROXY_URL=
# IG_BROWSER_PROFILE=          # Playwright profile dir (default ~/.cache/content-kb/ig-browser-profile)

# --- residential proxy rotation for ig_session_guardian.py (optional) ---
# GPROXY_API_URL=
# GPROXY_API_KEY=
# GPROXY_COUNTRY=

# --- Codex CLI (optional; defaults shown) ---
# CODEX_BIN=codex
# CODEX_MODEL=gpt-5.6-sol
# CODEX_REASONING=medium
# CODEX_TIMEOUT_SECONDS=300

# --- behaviour ---
# BATCH_DEBOUNCE_SECONDS=25    # consecutive messages merged into one entry
