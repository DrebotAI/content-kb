[Unit]
Description=Instagram persistent session guardian for content-kb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=content-kb
TimeoutStartSec=150
WorkingDirectory=/opt/content-kb
ExecStart=/opt/content-kb/venv/bin/python /opt/content-kb/tools/ig_session_guardian.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# browser profile inside WorkingDirectory: ProtectHome=read-only blocks ~/.cache
Environment=IG_BROWSER_PROFILE=/opt/content-kb/ig-browser-profile
ReadWritePaths=/opt/content-kb

[Install]
WantedBy=multi-user.target
